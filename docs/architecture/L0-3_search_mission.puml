@startuml L0-3_search_mission
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"

mainframe sd search mission

actor "operator (user)" as USER
participant "laptop" as laptop
participant "robot" as robot
participant "pico" as pico

USER -> laptop : start search
loop explore
  robot -> laptop : sensor summary, odometry (periodic)
  laptop -> laptop : update map (mapping)
  laptop -> laptop : extract frontiers, LLM choice (mission)
  laptop -> laptop : plan path (planning)
  laptop -> robot : path (waypoints)
  loop track path (control)
    robot -> pico : drive command (periodic)
    pico -> robot : encoders, ultrasonic, flags
    opt proximity, cliff, tilt, stall (safety)
      robot -> pico : stop
      robot -> laptop : safety event
      laptop -> laptop : replan
    end
  end
  opt person candidate (perception)
    laptop -> laptop : project detection to map frame
    laptop -> robot : approach path
    laptop -> laptop : verify (re-detect up close)
    alt confirmed
      laptop -> robot : stop
      robot -> pico : stop
      laptop -> USER : report (map position, image, time)
    else false positive
      laptop -> laptop : reject candidate, keep exploring
    end
  end
end

legend bottom right
  |= 도면 | L0-3 |
  |= 상위 | L0-2 |
  |= 펼친 박스 | 전체 (수색 미션 시간 흐름) |
  |= 기준 | autonomous-rescue-rover main 4c5a4ef |
  |= 날짜 | 2026-11-13 |
endlegend
@enduml
