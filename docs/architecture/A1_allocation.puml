@startuml A1_allocation
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam ArrowFontSize 11

frame "dpl RoverAid 기능 배치" {
  actor "운영자" as OP

  node "노트북 (서버)" as LAP {
    rectangle "F2 SLAM (지도·위치 보정)" as L2
    rectangle "F3 사람 탐지 · 탐지 지도 좌표화" as L3
    rectangle "F4 임무 판단\n(frontier + LLM, 임무 상태)" as L4
    rectangle "F5 경로 계획" as L5
    rectangle "F7 운영자 화면·명령" as L7
    rectangle "F8 주행 기록·평가 지표" as L8
  }

  node "Raspberry Pi 4 (로버)" as PI {
    rectangle "F1 센서 수집\n(라이다·IMU·카메라)" as P1
    rectangle "F2 odometry\n(엔코더 + IMU)" as P2
    rectangle "F5 경로 추종 · 역기구학" as P5
    rectangle "F6 근접·낭떠러지·기울기\n걸림·통신 두절 정지" as P6
    rectangle "F8 raw 기록" as P8
  }

  node "Pico 2 (로버)" as PICO {
    rectangle "F1 엔코더·초음파 읽기" as C1
    rectangle "F5 PWM 출력" as C5
    rectangle "F6 출력 제한 · 링크 타임아웃" as C6
  }

  rectangle "센서\n라이다 · IMU · 카메라(마이크)" as SENS_PI
  rectangle "센서\n엔코더 ×2 · 초음파 ×4" as SENS_PICO
  rectangle "구동기\n모터 ×6 (좌/우 2채널) · 서보 ×4" as ACT

  OP <--> LAP : 화면·명령
  LAP <--> PI : Wi-Fi (Tailscale)\n↑ 센서 요약·위치·상태·안전 이벤트·영상\n↓ 경로·모드·정지
  PI <--> PICO : USB 시리얼\n↓ 구동 명령 / ↑ 엔코더·초음파·상태
  SENS_PI --> PI
  SENS_PICO --> PICO
  PICO --> ACT
}

legend bottom right
  |= 도면 | A1 |
  |= 상위 | A0 |
  |= 펼친 박스 | 전체 (배치 관점) |
  |= 기준 | autonomous-rescue-rover main 4c5a4ef |
  |= 날짜 | 2026-11-13 |
endlegend
@enduml
