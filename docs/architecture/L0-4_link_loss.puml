@startuml L0-4_link_loss
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"

mainframe sd link loss

participant "laptop" as laptop
participant "robot" as robot
participant "pico" as pico

== laptop ↔ robot link lost ==
robot -> robot : detect missing laptop messages (safety)
robot -> pico : stop (speed 0), keep sending commands
note right of robot
  localization and raw logging continue
  (pose during the outage is kept)
end note

== reconnected ==
robot -> laptop : current odometry, safety events during outage
laptop -> laptop : correct pose (mapping), replan
laptop -> robot : new path

== robot ↔ pico link lost (robot hang etc.) ==
pico -> pico : link timeout → speed 0, steering neutral (safety)

legend bottom right
  |= 도면 | L0-4 |
  |= 상위 | L0-2 |
  |= 펼친 박스 | safety (통신 두절) |
  |= 기준 | autonomous-rescue-rover main 4c5a4ef |
  |= 날짜 | 2026-11-13 |
endlegend
@enduml
