@startuml L1-3_navigation
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam componentStyle rectangle
skinparam ArrowFontSize 11
top to bottom direction

rectangle "mission / perception" as MISSION #line.dashed

frame "cmp navigation" {
  component "mapping\n(slam_toolbox)" <<laptop>> <<planned>> as MAP
  component "planning\n(frontier 추출, costmap + A*)" <<laptop>> <<planned>> as PLAN
  component "state estimation\n(EKF: encoders + IMU\n+ optical flow (2단계))" <<robot>> <<planned>> as EKF
  component "path tracking\n(Pure Pursuit)" <<robot>> <<planned>> as TRACK
}

rectangle "control / safety" as CONTROL #line.dashed

MISSION --> PLAN : goal id
PLAN -up-> MISSION : frontier list (id)
MAP -up-> MISSION : map, pose

CONTROL -up-> EKF : encoders, IMU\ncamera (floor region)
CONTROL -up-> MAP : LiDAR scan
EKF -up-> MAP : pose
MAP --> PLAN : map, pose
PLAN --> TRACK : path (waypoints)
EKF --> TRACK : pose
TRACK --> CONTROL : motion command (v, ω)

legend bottom right
  |= 도면 | L1-3 |
  |= 상위 | L0-1 |
  |= 펼친 박스 | navigation |
  |= 기준 | autonomous-rescue-rover main 4c5a4ef (ros2/rover_localization: 모의 odometry만) |
  |= 날짜 | 2026-11-14 |
  |= 표기 | 점선 = 이웃 L0 박스, <<laptop>>/<<robot>> = 실행 기기 |
  |= | laptop → robot 경계는 path만 넘는다 (속도 명령은 Wi-Fi를 타지 않음) |
endlegend
@enduml
