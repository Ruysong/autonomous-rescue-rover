@startuml L1-3_navigation
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam componentStyle rectangle
skinparam ArrowFontSize 11
top to bottom direction

rectangle "mission / perception" as MISSION #line.dashed

frame "cmp navigation" {
  component "mapping\nScanSlam (laptop/navigation/slam.py)\noccupancy grid + scan matching" <<laptop>> as MAP
  component "planning\nplanner.py + Explorer\n(frontier id, Dijkstra 경로)" <<laptop>> as PLAN
  component "state estimation\nOdometry (robot/src/navigation)\nencoders + IMU (EKF · optical flow는 다음)" <<robot>> as EKF
  component "path tracking\nPathFollower (Pure Pursuit,\n3-point turn, LiDAR 정지 상자)" <<robot>> as TRACK
}

rectangle "control / safety" as CONTROL #line.dashed

MISSION --> PLAN : goal id (selector)\nmoving tracks (planned)
PLAN -up-> MISSION : frontier list (id)
MAP -up-> MISSION : map, pose

CONTROL -up-> EKF : encoders, IMU
CONTROL -up-> MAP : LiDAR scan
EKF -up-> MAP : odom pose (scan과 함께)
MAP --> TRACK : pose correction (map ← odom)
MAP --> PLAN : map, pose
PLAN --> TRACK : path (waypoints)
EKF --> TRACK : odom pose
CONTROL -up-> TRACK : LiDAR scan (정지 상자)
TRACK --> CONTROL : motion (v, κ), source autonomous

legend bottom right
  |= 도면 | L1-3 |
  |= 상위 | L0-1 |
  |= 펼친 박스 | navigation |
  |= 기준 | yw/autonomy (laptop/navigation, robot/src/navigation) |
  |= 날짜 | 2026-11-15 |
  |= 표기 | 점선 = 이웃 L0 박스, <<laptop>>/<<robot>> = 실행 기기 |
  |= | laptop → robot 경계는 path · pose correction만 넘는다 |
  |= | 사용법 docs/AUTONOMY.md, 프로토콜 v1.2 |
endlegend
@enduml
