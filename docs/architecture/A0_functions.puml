  rectangle "환경\n(실내 재난 현장)" as ENV
  rectangle "구동기\n(모터·서보)" as ACT

  component "F1 감지" as F1
  component "F2 위치·지도" as F2
  component "F3 상황 인식" as F3
  component "F4 임무 판단" as F4
  component "F5 이동" as F5
  component "F6 보호" as F6
  component "F7 운영자 연결" as F7
  component "F8 기록·평가" as F8

  ENV --> F1 : 물리량
  F1 --> F2 : 거리·회전·자세
  F1 --> F3 : 영상·소리
  F1 --> F6 : 근접·바닥·천장\n기울기·바퀴 회전
  F2 --> F3 : 현재 위치
  F2 --> F4 : 지도·현재 위치
  F3 --> F4 : 탐지 (지도 좌표)
  F4 --> F5 : 목표
  F2 --> F5 : 지도·현재 위치
  F5 --> F6 : 구동 요청
  F6 --> ACT : 허용된 구동
  F6 --> F4 : 안전 이벤트
  F4 --> F7 : 임무 상태·보고
  F7 --> F4 : 시작·정지·수동 개입
  F7 --> F6 : 비상정지
  OP <--> F7
  F8 .. F1 : 모든 흐름을 기록
}

legend bottom right
